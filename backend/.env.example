# --- Application ---
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM: requirement extraction, coverage judging, rewrites (DeepSeek) ---
# Without this the API still runs: JD extraction falls back to regex rules and
# coverage falls back to similarity thresholds.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Embeddings + optional reranker (Voyage AI) ---
# Without this retrieval falls back to an IDF-weighted lexical scorer.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
# Unpaid Voyage keys are limited to 3 requests/minute. Calls are shaped by a
# token bucket; raise this after adding billing.
VOYAGE_REQUESTS_PER_MINUTE=3
# Per-requirement reranking costs one request each, so it is opt-in.
VOYAGE_RERANK_ENABLED=false

# --- Storage (Neon Postgres + pgvector) ---
# Optional. Without it the API is stateless: no shareable reports, no caching.
DATABASE_URL=

# --- Abuse and cost control ---
RATE_LIMIT_PER_DAY=25
# Comma-separated keys that bypass the IP rate limit via the X-API-Key header.
API_KEYS=
